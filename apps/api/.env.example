# Copy to apps/api/.env for local overrides. Real environment variables take precedence.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 3000). `pnpm dev` ignores this and uses API_PORT (default 3000),
# so a PORT meant for another tool can't collide with the web dev server.
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
