# Copy to apps/web/.env.local for local overrides.

# Base URL of the API, baked in at build time. Leave empty to call the API on the same origin
# (the default: in dev, Vite proxies /api and /health to the API).
VITE_API_BASE_URL=

# Dev only: where Vite's proxy forwards /api and /health (default: http://localhost:3000).
# API_PROXY_TARGET=http://localhost:3000
